{% comment %} Familien To-Do - Half Horizontal: two lists side by side {% endcomment %}

<div class="layout">
  {% if has_data and total_open > 0 %}

  <div class="flex flex--row gap--medium h--full">
    {% for list in lists limit: 2 %}
    <div class="flex flex--col gap--xsmall" style="flex: 1;">
      <div class="label">{{ list.name }} ({{ list.open_count }})</div>
      <ul class="list">
        {% for it in list.items limit: 5 %}
        <li class="description" data-clamp="1">☐ {{ it.text }}</li>
        {% endfor %}
      </ul>
    </div>
    {% if forloop.first %}<div class="divider divider--vertical"></div>{% endif %}
    {% endfor %}
  </div>

  {% elsif has_data %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small h--full">
    <div class="value value--large">🎉</div>
    <div class="title title--small md:title--medium text--center">Alles erledigt!</div>
  </div>
  {% else %}
  <div class="flex flex--col flex--center-x flex--center-y gap--small h--full">
    <div class="value value--large">📝</div>
    <div class="title title--small md:title--medium text--center">Keine Aufgaben</div>
  </div>
  {% endif %}
</div>

<div class="title_bar">
  <span class="title md:title--medium">✅ Familien To-Do</span>
  <span class="instance">{{ total_open | default: 0 }} offen</span>
</div>
