{% comment %}
  Familien To-Do - Full layout
  Data contract (see backend/src/todo.ts toTrmnlPayload()):
  { has_data, updated_at, total_open, total_lists, lists, top_items: [{text,list,assignee,dueDate}] }
  A single clean checklist (not grouped by list) reads far better on e-ink than a cramped
  multi-column grid - list/assignee/due date show as a small meta line under each item.
  Read-only on the device - check items off at /todo (see settings.yml tap_action_url).
{% endcomment %}

<div class="layout">
  {% if has_data and total_open > 0 %}

  <div class="flex flex--col gap--small h--full">
    {% for it in top_items limit: 8 %}
    <div class="flex flex--col gap--xsmall">
      <span class="title title--small md:title--medium" data-clamp="1">☐ {{ it.text }}</span>
      {% if it.assignee or it.dueDate %}
      <span class="label label--small">
        {% if it.assignee %}{{ it.assignee }}{% endif %}{% if it.assignee and it.dueDate %} · {% endif %}{% if it.dueDate %}fällig {{ it.dueDate | date: "%d.%m." }}{% endif %}
      </span>
      {% endif %}
    </div>
    {% unless forloop.last %}<div class="divider"></div>{% endunless %}
    {% endfor %}

    {% if total_open > 8 %}
    <div class="label label--small text--center">+{{ total_open | minus: 8 }} weitere</div>
    {% endif %}
  </div>

  {% elsif has_data %}

  <div class="flex flex--col flex--center-x flex--center-y gap--medium h--full">
    <div class="value value--large md:value--xlarge text--center">🎉</div>
    <div class="title title--medium md:title--large text--center">Alles erledigt!</div>
  </div>

  {% else %}

  <div class="flex flex--col flex--center-x flex--center-y gap--medium h--full">
    <div class="value value--large md:value--xlarge text--center">📝</div>
    <div class="title title--medium md:title--large text--center">Keine Aufgaben</div>
    <div class="description md:title md:title--small text--center">
      Aufgaben hinzufuegen unter /todo auf dem Backend.
    </div>
  </div>

  {% endif %}
</div>

<div class="title_bar">
  <span class="title md:title--large">✅ Familien To-Do</span>
  <span class="instance">{{ total_open | default: 0 }} offen</span>
</div>
