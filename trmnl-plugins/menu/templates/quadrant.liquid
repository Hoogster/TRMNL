{% comment %} Menü-Inspiration - Quadrant: bare minimum, today's dish name only {% endcomment %}

<div class="layout">
  {% if has_data %}

  <div class="flex flex--col flex--center-x flex--center-y h--full gap--xsmall">
    <div class="value value--medium md:value--large" data-clamp="1">🍽️</div>
    <div class="title title--small md:title--medium text--center" data-clamp="2">
      {{ today.name }}
    </div>
  </div>

  {% else %}

  <div class="flex flex--col flex--center-x flex--center-y gap--xsmall h--full">
    <div class="value value--small md:value--medium">🍽️</div>
    <div class="description text--center">Keine Idee</div>
  </div>

  {% endif %}
</div>

<div class="title_bar">
  <span class="title title--small">Menü</span>
</div>
