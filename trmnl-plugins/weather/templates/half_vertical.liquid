{% comment %} Wetter Wabern - Half Vertical layout: current on top, 3-day outlook below {% endcomment %}

<div class="layout">
  {% if has_data %}

  <div class="flex flex--col gap--small h--full">
    <div class="flex flex--center-x flex--center-y" style="flex: 1;">
      <div class="richtext richtext--center gap--xsmall">
        <div class="content content--center gap--xsmall text--center">
          <div class="value value--xxlarge md:value--xxxlarge" data-clamp="1">
            {{ current.symbol }} {{ current.temp_c | default: "-" }}°
          </div>
          <div class="title title--medium md:title--large">{{ location_name }}</div>
          <div class="description md:title md:title--small" data-clamp="1">{{ current.symbol_text }}</div>
        </div>
      </div>
    </div>

    <div class="divider"></div>

    {% if daily and daily.size > 0 %}
    <div class="grid grid--cols-3 gap--xsmall text--center">
      {% for d in daily limit: 3 %}
      <div>
        <div class="label label--small">{{ d.day }}</div>
        <div class="value value--xsmall">{{ d.symbol }}</div>
        <div class="value value--xsmall value--tnums">{{ d.high_c | default: "-" }}°/{{ d.low_c | default: "-" }}°</div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="grid grid--cols-3 gap--xsmall text--center">
      <div><div class="label label--small">Max</div><div class="value value--small value--tnums">{{ today.high_c | default: "-" }}°</div></div>
      <div><div class="label label--small">Min</div><div class="value value--small value--tnums">{{ today.low_c | default: "-" }}°</div></div>
      <div><div class="label label--small">Regen</div><div class="value value--small value--tnums">{{ today.precip_probability_pct | default: "-" }}%</div></div>
    </div>
    {% endif %}
  </div>

  {% else %}

  <div class="flex flex--col flex--center-x flex--center-y gap--small h--full">
    <div class="value value--medium md:value--large">🌦️</div>
    <div class="title title--small md:title--medium text--center">Keine Wetterdaten</div>
  </div>

  {% endif %}
</div>

<div class="title_bar">
  <span class="title md:title--medium">🌤️ Wetter {{ location_name }}</span>
  <span class="instance">{{ updated_at | date: "%H:%M" }}</span>
</div>
